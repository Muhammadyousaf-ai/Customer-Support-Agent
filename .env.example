# ---- Backend (apps/api) ----------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated public frontend origin(s). CORS and the voice WebSocket check this. Must not be localhost in production.
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://support:support@localhost:5433/support_ai
APP_VERSION=1.0.0

# ---- OpenAI (the key stays on the server; never put it in a NEXT_PUBLIC_* variable) -------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Live voice (OpenAI Realtime). `pnpm --filter api voice:smoke` checks key access and the adapter.
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=marin

# ---- Security -----------------------------------------------------------------------------------------------------------
# Required in production (16+ chars): unlocks prompt traces, tool arguments and /health/dependencies.
ADMIN_API_KEY=
MAX_BODY_BYTES=32768
RATE_LIMIT_SESSION_PER_MIN=10
RATE_LIMIT_IP_PER_MIN=60
SSE_MAX_CONNECTIONS_PER_SESSION=4

# ---- Cost protection (approximate application limits, not a provider billing cap) ---------------------------------------
DAILY_AI_BUDGET_USD=5
BUDGET_RUN_RESERVE_USD=0.01
BUDGET_VOICE_RESERVE_USD=0.1
BUDGET_UNPRICED_CALL_USD=0.002

# ---- Agent limits -------------------------------------------------------------------------------------------------------
MAX_AUTO_REFUND_USD=100
AGENT_MAX_ITERATIONS=12
AGENT_MAX_TOOL_CALLS=15
AGENT_DEADLINE_MS=60000
AGENT_CONFIRMATION_TTL_MS=900000
AGENT_HISTORY_WINDOW=20
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2
# Sanitized prompt text in the legacy llm_calls table (the Phase 7 model_invocations table always stores sanitized prompts).
TRACE_PROMPTS=false

# ---- RAG ----------------------------------------------------------------------------------------------------------------
KNOWLEDGE_BASE_DIR=../../knowledge-base
# EMBEDDINGS_PROVIDER=local   # offline lexical embedder for tests/demos without a key
# RETRIEVAL_MIN_SIMILARITY=   # the threshold calibrated in Phase 2 (docs/rag.md)

# ---- Voice limits ---------------------------------------------------------------------------------------------------------
VOICE_MAX_SESSION_MINUTES=10
VOICE_MAX_RECONNECT_ATTEMPTS=3
VOICE_INPUT_SAMPLE_RATE=16000
VOICE_OUTPUT_SAMPLE_RATE=24000
VOICE_CHUNK_DURATION_MS=40
# VOICE_PROVIDER=fake         # scripted provider for tests; refused in production

# ---- Observability / shutdown ---------------------------------------------------------------------------------------------
LOG_LEVEL=info
TELEMETRY_RETENTION_DAYS=30
SHUTDOWN_GRACE_MS=20000

# ---- Development-only test doubles and failure simulation (all refused in production) ------------------------------------
# AGENT_LLM=e2e               # scripted agent model for browser tests
SIMULATE_FAILURE=none         # none | tool | llm_timeout | retrieval | voice_disconnect

# ---- Web (apps/web) -------------------------------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
